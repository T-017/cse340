<%- include('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>

    <% if (project) { %>
      <h2>
        <%= project.title %>
      </h2>
      <p>
        <%= project.description %>
      </p>
      <p><strong>Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString() %>
      </p>
      <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
      </p>

      <% if (categories && categories.length> 0) { %>
        <p><strong>Categories:</strong></p>
        <ul class="category-tags">
          <% categories.forEach(category=> { %>
            <li>
              <a href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
            </li>
            <% }) %>
        </ul>
        <% } %>

          <p><a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a></p>
          <% } else { %>
            <p>Project not found.</p>
            <% } %>
  </main>
  <%- include('partials/footer') %>