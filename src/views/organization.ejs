<%- include('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>

    <% if (organizationDetails) { %>
      <h2>
        <%= organizationDetails.name %>
      </h2>
      <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

      <p>Description: <%= organizationDetails.description %>
      </p>
      <p>Contact: <a href="mailto:<%= organizationDetails.contact_email %>">
          <%= organizationDetails.contact_email %>
        </a></p>

      <h3>Service Projects</h3>
      <ul>
        <% if (projects && projects.length> 0) { %>
          <% projects.forEach(project=> { %>
            <li>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
              (<%= new Date(project.project_date).toLocaleDateString() %>)
            </li>
            <% }) %>
              <% } else { %>
                <li>No projects found for this organization.</li>
                <% } %>
      </ul>
      <% } else { %>
        <p>Organization not found.</p>
        <% } %>
  </main>
  <%- include('partials/footer') %>